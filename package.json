{
  "name": "presenter-ops",
  "private": true,
  "version": "0.1.0",
  "description": "Freelance presenter work assignment, tracking and performance system",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run start:dev --workspace @presenter-ops/api",
    "dev:web": "npm run dev --workspace @presenter-ops/web",
    "build": "npm run build --workspace @presenter-ops/shared && npm run build --workspace @presenter-ops/api && npm run build --workspace @presenter-ops/web",
    "build:shared": "npm run build --workspace @presenter-ops/shared",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace @presenter-ops/api",
    "db:seed": "npm run prisma:seed --workspace @presenter-ops/api",
    "db:studio": "npm run prisma:studio --workspace @presenter-ops/api",
    "setup": "npm install && npm run build:shared && npm run db:up && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
