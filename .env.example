# =============================================================================
# PresenterOps — environment variables
#
# Copy to .env for local development:   cp .env.example .env
# In production these are set in the Railway (API) and Vercel (web) dashboards.
# Never commit a filled-in .env.
# =============================================================================

# --- API ---------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Where the web app is served from. Used in emails and for CORS.
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Postgres. Locally this matches docker-compose.yml.
# On Railway, use the DATABASE_URL the Postgres plugin provides.
DATABASE_URL=postgresql://presenter:presenter@localhost:5432/presenter_ops?schema=public

# --- Auth --------------------------------------------------------------------

# Generate with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-48-random-bytes
COOKIE_SECRET=replace-me-too

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TTL_DAYS=14

# Leave COOKIE_DOMAIN blank unless the API and web app share a parent domain
# (e.g. api.yourdomain.com + app.yourdomain.com → set .yourdomain.com).
COOKIE_DOMAIN=
# 'none' is required when the API and web app are on different domains, which
# is the default Railway + Vercel setup. It also requires HTTPS in production.
COOKIE_SAMESITE=lax

# --- Object storage (scripts, briefs, contracts) ------------------------------
# Videos are NOT stored here — they stay in OneDrive and we hold the link.
#
# Local (MinIO from docker-compose):
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=presenter-ops
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
#
# Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=false
#
# AWS S3:
#   leave S3_ENDPOINT blank, set S3_REGION=eu-west-2

S3_PRESIGN_TTL=900
MAX_UPLOAD_BYTES=104857600

# --- Email -------------------------------------------------------------------
# With MAIL_ENABLED=false, emails are written to the API log instead of sent.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PresenterOps <no-reply@yourdomain.com>

# --- AI (optional, OpenRouter) -----------------------------------------------
# Every AI feature is hidden in the UI while AI_ENABLED=false.
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_SITE_URL=https://yourdomain.com
OPENROUTER_SITE_NAME=PresenterOps
OPENROUTER_MAX_TOKENS=1500
OPENROUTER_TIMEOUT_MS=45000

# --- Diagnostics -------------------------------------------------------------
LOG_SLOW_QUERIES=true
ENABLE_SWAGGER=true

# =============================================================================
# WEB (apps/web) — these belong in apps/web/.env.local, or Vercel's dashboard
# =============================================================================

# Public API base. Must include the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=PresenterOps
